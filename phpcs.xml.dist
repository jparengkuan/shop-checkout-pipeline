<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="shop-checkout-pipeline">
    <description>Coding standard for this project: PSR-12.</description>

    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <file>bin/</file>
    <file>config/</file>
    <file>public/</file>
    <file>src/</file>

    <!-- Generated by Symfony, not ours to reformat. -->
    <exclude-pattern>config/reference.php</exclude-pattern>
</ruleset>
