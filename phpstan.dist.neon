parameters:
    level: 5
    paths:
        - bin/
        - config/
        - public/
        - src/
    excludePaths:
        # Generated by Symfony.
        - config/reference.php
    symfony:
        # Lets PHPStan resolve services and parameters; built by any dev cache warmup.
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
